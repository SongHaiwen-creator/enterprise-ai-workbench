# Local PostgreSQL container or native service
POSTGRES_USER=workbench
POSTGRES_PASSWORD=workbench_local
POSTGRES_DB=enterprise_ai_workbench
POSTGRES_PORT=5432

# Backend runtime
DATABASE_URL=postgresql+psycopg://workbench:workbench_local@localhost:5432/enterprise_ai_workbench

# Integration tests only
TEST_DATABASE_URL=postgresql+psycopg://workbench:workbench_local@localhost:5432/enterprise_ai_workbench_test

# Authentication (set JWT_SECRET_KEY to a secret of at least 32 bytes)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Embeddings (leave the API key empty until RAG indexing/search is used)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Grounded generation (fixed Feature 009 contract)
GENERATION_MODEL=gpt-5.6-terra
GENERATION_REASONING_EFFORT=low
GENERATION_PROMPT_VERSION=grounded-answer-v1
GENERATION_RETRIEVAL_LIMIT=5
GENERATION_MAX_INPUT_TOKENS=12000
GENERATION_MAX_OUTPUT_TOKENS=1200

# Agent intent routing (fixed Feature 011 contract)
ROUTING_MODEL=gpt-5.6-terra
ROUTING_REASONING_EFFORT=low
ROUTING_PROMPT_VERSION=agent-intent-routing-v1
ROUTING_MAX_INPUT_TOKENS=8000
ROUTING_MAX_OUTPUT_TOKENS=64
OPENAI_TIMEOUT_SECONDS=30
